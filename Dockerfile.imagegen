# An uncensored image model (SDXL, diffusers) behind an AUTOMATIC1111-style API, for the bot's
# generate_image in age-restricted channels. Built for Cloud Run GPU (NVIDIA L4); see
# docs/deploy/cloud-run-imagegen.md. The checkpoint is not baked in: IMAGEGEN_MODEL names a
# Hugging Face repo, or a .safetensors file on a mounted bucket.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/tmp/hf \
    PORT=8080

WORKDIR /app
RUN pip install "diffusers>=0.31,<1" "transformers>=4.45,<5" "accelerate>=1.0,<2" "safetensors>=0.4" \
    "fastapi>=0.115,<1" "uvicorn[standard]>=0.32,<1" "pillow>=10"
COPY imagegen/server.py ./server.py

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin imagegen
USER imagegen
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn server:app --host 0.0.0.0 --port ${PORT:-8080}"]
