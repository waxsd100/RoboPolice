## Secrets in Google Cloud Secret Manager (optional, see README)
# NAME=secret-id pairs, from `terraform output -raw gcp_secrets` in infra/terraform. Each named
# variable is read from Secret Manager at startup; remove it from this file / the platform.
GCP_SECRETS=
# The runtime service account's JSON key, base64-encoded (or as is).
GCP_SERVICE_ACCOUNT_KEY=
# Optional. Defaults to the key's project.
GCP_PROJECT_ID=

## Discord
BOT_TOKEN=get one from discord developers page
CREATOR_IDS=
# Optional. One role ID (right-click a role in Discord with Developer Mode on -> Copy Role ID).
# A member holding this role, or any role positioned at or above it in Settings > Roles, bypasses
# the same permission checks a server owner already bypasses (a required permission, a list of
# required permissions, or an admin-only command) - not creator-only commands, and not what the
# bot itself needs. Leave unset to disable: nobody gets a bypass from this.
STAFF_ROLE_ID=
DISCORD_WEBHOOK_URL=error logging channel webhook goes here
GLOBAL_BOT_PREFIX=%

## Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=logger
PGUSER=postgresusername
PGPASSWORD=postgrespassword

## Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

## Retention
# Retention window for stored messages. Rows older than this are deleted by
# src/miscellaneous/prune.js. The Privacy Policy states this same number, so keep the two in sync.
# Unset (or 0/non-numeric) = retention is unlimited by design: nothing is ever pruned. The bot
# logs this at startup and /clearmydata + /help say so instead of naming a day count.
MESSAGE_HISTORY_DAYS=30
# Set to true only if you run prune.js as a separate Railway Cron service, so the bot
# stops scheduling its own sweep.
PRUNE_EXTERNAL=false

## Miscellaneous
AES_KEY=youraeskey

## Drafting from mentions (@mention the bot with text or a URL to create a server event or forum post)
# Both required to enable it. Leave unset and mentions are ignored.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
# Optional. Only for an authenticated gateway.
CLOUDFLARE_AI_GATEWAY_TOKEN=
# Optional. Name of the Gemini key stored in the gateway (BYOK). Unset uses the one named "default".
CLOUDFLARE_AI_GATEWAY_BYOK_ALIAS=
# Optional when the Gemini key is stored in the gateway (BYOK).
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional. Image model for "AIで作成" covers. Defaults to gemini-3.1-flash-image.
GEMINI_IMAGE_MODEL=
# Optional. OpenAI-compatible uncensored fallback when Gemini refuses a mention (PROHIBITED_CONTENT / SAFETY).
# Set UNCENSORED_API_URL (e.g. https://<service>.run.app/v1 — see docs/deploy/cloud-run-gpu.md — or https://<user>-<space>.hf.space/v1)
# or UNCENSORED_GATEWAY_PROVIDER (slug of an AI Gateway custom provider).
UNCENSORED_API_URL=
UNCENSORED_GATEWAY_PROVIDER=
UNCENSORED_API_KEY=
# Optional. Model 1 (normal safety fallback). Defaults to auto-detected model from /v1/models or xtools-at/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic.
UNCENSORED_MODEL=
# Optional. Model 2 (R18 / creative handoff fallback). Defaults to UNCENSORED_MODEL when unset.
UNCENSORED_R18_MODEL=
# Optional. Set to true when using scale-to-zero endpoints (e.g. Cloud Run GPU min-instances=0) so bot startup does not trigger a cold start.
UNCENSORED_SKIP_STARTUP_PROBE=
# Optional. GeneLab/sokudan-ja-310m sidecar URL (see Dockerfile.sokudan, docs/deploy/railway-sokudan.md, and docker-compose.yml),
# e.g. http://sokudan.railway.internal:8000 (Railway), http://sokudan:8000 (Docker Compose / GKE), or http://127.0.0.1:8000.
# Used for mention pre-routing (intent/deep/R18/thinking), prompt-injection & soft-refusal screening, and replyPolish pre-screening.
SOKUDAN_URL=
SOKUDAN_API_KEY=
SOKUDAN_TIMEOUT_MS=
SOKUDAN_BOOL_THRESHOLD=
# Optional. YouTube Data API v3 key for /youtube (each server's channel, read when the command runs).
YOUTUBE_API_KEY=
# Optional. Slug of an AI Gateway custom provider with base URL https://www.googleapis.com, to send
# YouTube API calls through Cloudflare AI Gateway. Unset calls Google directly.
YOUTUBE_GATEWAY_PROVIDER=
# Optional. How long to wait for Gemini to summarize a video, in minutes. Defaults to 10.
VIDEO_SUMMARY_TIMEOUT_MINUTES=
# Optional. How many videos /youtube summarize summarizes at once (1-10). Defaults to 3.
VIDEO_SUMMARY_CONCURRENCY=
# Optional. How often (minutes) to check each server's YouTube channel for new videos and sync, when YouTube pushes
# (YOUTUBE_WEBSUB_URL) are not set up; with them, a channel is synced when YouTube pushes an upload. Defaults to 15; 0 is off.
YOUTUBE_AUTO_SYNC_MINUTES=
# Optional. How often (seconds) to check for streams on servers with /youtube liveevents on. Defaults to 60; 0 is off.
YOUTUBE_LIVE_POLL_SECONDS=
# Optional. To get YouTube pushes (new streams in seconds): the service's public HTTPS address, e.g.
# https://robopolice.up.railway.app, and any long random secret. Both or neither.
YOUTUBE_WEBSUB_URL=
YOUTUBE_WEBSUB_SECRET=
# Optional. true embeds every stored message for search by meaning. This sends every stored message
# to Google Gemini: update the Privacy Policy first. Off by default (videos are embedded regardless).
MESSAGE_EMBEDDINGS=
# Shorter messages (in letters or digits, without links, emojis and mentions) are not embedded. Default 5.
MESSAGE_EMBEDDING_MIN_CHARS=
# Optional. How often (minutes) to embed new videos and messages. Defaults to 5; 0 is off.
EMBEDDING_INTERVAL_MINUTES=
# Optional. Embedding model (embedding_model enum: gemini-embedding-001 [default], gemini-embedding-2-preview, gemini-embedding-2, text-embedding-004). Changing it embeds everything again.
GEMINI_EMBEDDING_MODEL=
# Optional. Character notes for chat replies to mentions (tone, catchphrases, how to address members).
CHAT_PERSONA=
# Optional. Gemini tokens each user may use for mentions across servers: per 5 hours (150000) and
# per week (750000), from their first use. 0 is no limit.
MENTION_TOKEN_LIMIT_5H=
MENTION_TOKEN_LIMIT_WEEK=
# Optional. Past this % of either window a user's mentions go to Flex (slower, half the price): 80.
MENTION_FLEX_AT_PERCENT=
# Optional. The bot's Gemini budget an hour (2000000): from 50% replies think at medium, from 80% at
# low and everything goes to Flex. 0 turns it off.
GEMINI_HOURLY_BUDGET=
GEMINI_LOAD_MEDIUM_AT=
GEMINI_LOAD_FLEX_AT=
# Optional. Prices (USD per 1M tokens) of models not in geminiPrices.js, as JSON:
# {"gemini-5-flash": {"input": 1, "cached": 0.1, "output": 5}}
MENTION_TOKEN_PRICES=

# Optional. false stops the one-time background search for the channel of messages stored before
# channels were recorded.
BACKFILL_CHANNELS=

# Optional. false stops the AI's line on what a stream is about in its Discord event.
LIVE_EVENT_AI_DESCRIPTION=
# Optional. false stops summarizing a stream's archive after it ends.
LIVE_ARCHIVE_SUMMARY=
# Optional. false stops describing the server's emojis from their image and name.
EMOJI_DESCRIPTIONS=
# Optional. Top pages of the community's wikis, comma-separated, read weekly as knowledge.
WIKI_URLS=https://novamanhikoushiki.memo.wiki/
# Optional. Hours between reads of a wiki (168) and milliseconds between its pages (1000).
WIKI_REFRESH_HOURS=
WIKI_DELAY_MS=
# Optional. The streamer's X accounts, comma-separated without @, read through FxTwitter as knowledge.
TWITTER_ACCOUNTS=nobamangames
# Optional. Hours between reads of new posts (6) and pages read back the first time (100).
TWITTER_REFRESH_HOURS=
TWITTER_MAX_PAGES=
# Optional. The streamer's Steam accounts (custom URL or 17-digit SteamID64, comma-separated), read as
# knowledge (profile, owned/played games, reviews and wishlist) without needing an API key.
STEAM_ACCOUNTS=nobaman
# Optional. Steam Web API key (IPlayerService/GetOwnedGames) to supplement public Steam Replay & review data.
STEAM_API_KEY=
# Optional. Minutes between Steam syncs (360).
STEAM_SYNC_MINUTES=
# Optional. The Twitch channels the bot follows (logins, comma-separated; needs TWITCH_CLIENT_ID and TWITCH_CLIENT_SECRET).
TWITCH_CHANNELS=nobaman
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional. Public web pages about the streamer (comma-separated URLs), read weekly as knowledge.
KNOWLEDGE_URLS=

# Optional. The owner's servers (comma-separated): no per-server mention cap, first in all background AI work.
OWNER_GUILD_IDS=615170683068219393
# Optional. Mentions a day for a whole server other than the owner's (30).
MENTION_GUILD_DAILY_LIMIT_OTHER=
# Optional. Background AI jobs at once per worker (3).
AI_BACKGROUND_CONCURRENCY=
# Optional. false leaves the games' pages (Steam or official) out of stream events.
GAME_LINKS=
# Optional. true puts Discord game mentions (<@$ID>) in stream events too.
EVENT_GAME_MENTIONS=
