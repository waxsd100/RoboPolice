## Discord
BOT_CREATOR_NAME=your discord username
BOT_TOKEN=get one from discord developers page
CREATOR_IDS=
# Optional. One role ID (right-click a role in Discord with Developer Mode on -> Copy Role ID).
# A member holding this role, or any role positioned at or above it in Settings > Roles, bypasses
# the same permission checks a server owner already bypasses (a required permission, a list of
# required permissions, or an admin-only command) - not creator-only commands, and not what the
# bot itself needs. Leave unset to disable: nobody gets a bypass from this.
STAFF_ROLE_ID=
DISCORD_SUPPORT_SERVER=https://discord.com/invite/nobaman
DISCORD_WEBHOOK_URL=error logging channel webhook goes here
ENABLE_TEXT_COMMANDS=true or false
GLOBAL_BOT_PREFIX=v3

## Postgress
PGHOST=localhost
PGPORT=5432
PGDATABASE=logger
PGUSER=postgresusername
PGPASSWORD=postgrespassword

## Reddis
REDIS_LOCK_TTL=2000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

## BOT Setting
USE_MAX_CONCURRENCY=false
MESSAGE_BATCH_SIZE=10
# Retention window for stored messages. Rows older than this are deleted by
# src/miscellaneous/prune.js. PRIVACY.md states this same number, so keep the two in sync.
# Unset = never delete (the bot warns on startup).
MESSAGE_HISTORY_DAYS=30
# Set to true only if you run prune.js as a separate Railway Cron service, so the bot
# stops scheduling its own sweep.
PRUNE_EXTERNAL=false

## Legal (registered with Discord; leave unset to use the URLs in src/bot/utils/constants.js)
#PRIVACY_POLICY_URL=
#TERMS_OF_SERVICE_URL=

## Miscellaneous settings
AES_KEY=youraeskey
# Optional. Leave unset to disable error reporting entirely. Note the name: the code reads
# SENTRY_URI, not RAVEN_URI as older copies of this file said, so a RAVEN_URI value does nothing.
SENTRY_URI=
PASTE_SITE_ROOT_URL=host your own haste-server instance to get this
#ZABBIX_HOST=            # optional, monitoring only
#BEZERK_URI=ws://localhost:1234
#BEZERK_SECRET=https://github.com/thesharks/bezerk
STAT_SUBMISSION_INTERVAL=