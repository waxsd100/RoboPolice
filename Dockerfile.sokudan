# Sidecar / standalone container for GeneLab/sokudan-ja-310m (Japanese System-1 decision model).
# Pre-downloads the ~310M parameter weights (Apache-2.0) at build time so runtime startup takes ~3s
# and requires no Hugging Face account or outbound internet access.
FROM python:3.12-slim

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG SOKUDAN_MODEL_ID=GeneLab/sokudan-ja-310m

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/hf_cache \
    SOKUDAN_MODEL=/app/model \
    PORT=8000 \
    SOKUDAN_BACKEND=auto \
    SOKUDAN_DEVICE=auto

WORKDIR /app

RUN pip install --upgrade pip && \
    pip install --extra-index-url "${TORCH_INDEX_URL}" torch && \
    pip install "sokudan[serve]>=0.3.0" huggingface_hub && \
    python -c "from huggingface_hub import snapshot_download; snapshot_download('${SOKUDAN_MODEL_ID}', local_dir='/app/model')" && \
    rm -rf /root/.cache /app/hf_cache

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin sokudan && \
    chown -R sokudan:sokudan /app

USER sokudan

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os, urllib.request; port = os.environ.get('SOKUDAN_PORT') or os.environ.get('PORT') or '8000'; urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=4).read()" || exit 1

# Auto-binds `::` (dual-stack IPv6 + IPv4) when IPv6 is available so Railway Private Networking
# (`*.railway.internal` over IPv6) and Docker/GKE IPv4 networking both work out of the box.
CMD ["sh", "-c", "HOST=\"${SOKUDAN_HOST:-$(python -c \"import socket; s=socket.socket(socket.AF_INET6); s.bind(('::', 0)); s.close(); print('::')\" 2>/dev/null || echo 0.0.0.0)}\"; LISTEN_PORT=\"${SOKUDAN_PORT:-${PORT:-8000}}\"; exec sokudan serve --model \"${SOKUDAN_MODEL}\" --host \"${HOST}\" --port \"${LISTEN_PORT}\" --backend \"${SOKUDAN_BACKEND}\" --device \"${SOKUDAN_DEVICE}\""]
